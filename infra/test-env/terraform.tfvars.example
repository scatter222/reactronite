# Copy this file to terraform.tfvars and customize the values

# Resource Group and Location
resource_group_name = "rg-reactronite-dev"
location            = "australiaeast" # Change to your preferred region

# VM Configuration
vm_name = "vm-reactronite-kvm"
vm_size = "Standard_D4s_v5" # 4 vCPUs, 16GB RAM — nested virt capable

# Admin Credentials
admin_username = "azureuser"

# SSH Key (recommended)
# Paste your public key here or leave as null to use ~/.ssh/id_rsa.pub
ssh_public_key = null

# Storage
os_disk_size_gb = 128

# Network Security — IMPORTANT: Restrict these to your IP!
allowed_ssh_ips = [
  "0.0.0.0/0" # CHANGE THIS to your IP address, e.g., "1.2.3.4/32"
]

allowed_http_ips = [
  "0.0.0.0/0" # CHANGE THIS to your IP address, e.g., "1.2.3.4/32"
]

# Tags
tags = {
  Environment = "Dev"
  Project     = "Reactronite"
  Purpose     = "KVM-Testing"
  Owner       = "YourName" # Add your name
}
